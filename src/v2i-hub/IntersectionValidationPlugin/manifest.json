  "version": "@PROJECT_VERSION@",
  "exeLocation": "/bin/IntersectionValidationPlugin",
  "coreIpAddr": "127.0.0.1",
  "corePort": 24601,
  "messageTypes": [
    {
      "type": "J2735",
