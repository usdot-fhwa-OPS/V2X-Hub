      "subtype": "MAP-P",
      "description": "Decoded MAP messages"
    },
    {
      "type": "J2735",
      "subtype": "TIM",
      "description": "Traveler Information Messages"
    }
  ],
  "configuration": [
    {
      "key": "Instance",
      "default": "0",
      "description": "The instance of this plugin."
    }
  ]
}